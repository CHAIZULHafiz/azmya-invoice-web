# ========================================================
# LINGKUNGAN TESTING (STAGING) - AZMYA INVOICE
# ========================================================
# File ini digunakan KHUSUS untuk pengujian di komputer lokal.
# JANGAN masukkan ID dari Google Sheets atau Folder asli di sini.
# ========================================================

# Server (Biarkan default 5000 untuk komputer Anda)
PORT=5000
JWT_SECRET=rahasia-untuk-testing-lokal-123

# Google Sheets & Auth (Gunakan Service Account yang sama tidak apa-apa, tapi SHEET-nya harus beda)
GOOGLE_SERVICE_ACCOUNT_EMAIL=invoice-azmya@azmya-car.iam.gserviceaccount.com
# Private key bisa dicopy dari .env yang asli jika pakai service account yang sama
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 1. Buka Google Sheets asli Anda, klik File > Make a Copy (Buat Salinan).
# 2. Ambil ID dari link salinan tersebut dan masukkan ke bawah ini:
GOOGLE_SHEETS_ID=[MASUKKAN_ID_SPREADSHEET_SALINAN_DISINI]

# Google Apps Script
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzlmSNnlx488p2u7WaOsDbzgG9f8B3TD7rt_iAfnvEeiaTH-52ZKpQVd8IXNXdeEVolFg/exec

# Google Docs Template
INVOICE_TEMPLATE_ID=1IG2Gb6mXWrShm5PQy7ZbgVr0M78Ug2qML1aycXdp_RI

# 1. Buat 1 folder baru di Google Drive (misal: "Folder Testing AZMYA").
# 2. Ambil ID folder tersebut dan masukkan untuk semua U1, U2, U3 di bawah ini 
#    (untuk testing, cukup 1 folder saja tidak masalah).
DRIVE_FOLDER_U1=[MASUKKAN_ID_FOLDER_TESTING_DISINI]
DRIVE_FOLDER_U2=[MASUKKAN_ID_FOLDER_TESTING_DISINI]
DRIVE_FOLDER_U3=[MASUKKAN_ID_FOLDER_TESTING_DISINI]
